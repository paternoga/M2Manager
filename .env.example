# ============================================================================
#  M2Manager — zmienne środowiskowe
#  Skopiuj do .env (lokalnie) albo wklej jako Environment Variables na Renderze.
#  Zagnieżdżenie w appsettings.json zapisujemy podwójnym podkreśleniem: Sekcja__Klucz
# ============================================================================

# ---------------------------------------------------------------- baza danych
# Connection string z Neon. Przyjmowany jest zarówno format URI, jak i klucz=wartość.
# Znajdziesz go w panelu Neon → Dashboard → Connection string.
ConnectionStrings__DefaultConnection=postgresql://uzytkownik:haslo@ep-nazwa-123456.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Alternatywnie (Render potrafi wstrzyknąć tę nazwę automatycznie):
# DATABASE_URL=postgresql://...

# Czy uruchamiać migracje EF przy starcie aplikacji.
Database__AutoMigrate=true

# ---------------------------------------------------------------- wspólne konto
# Login wspólny dla obu osób.
Auth__Username=dom

# ZALECANE: hash hasła zamiast hasła jawnego.
# Wygenerujesz go poleceniem:
#   dotnet run --project M2Manager.Api -- hash-password "twoje-haslo"
Auth__PasswordHash=

# Awaryjnie (tylko lokalnie) — hasło jawne. Zostaw puste, jeśli używasz PasswordHash.
Auth__Password=

# Po ilu dniach wygasa sesja.
Auth__SessionDays=30

# ---------------------------------------------------------------- Cloudflare R2
# Account ID z panelu Cloudflare (sekcja R2, prawa kolumna).
R2__AccountId=

# Token R2 z uprawnieniem „Object Read & Write”.
R2__AccessKeyId=
R2__SecretAccessKey=

# Nazwa prywatnego bucketu na zdjęcia faktur.
R2__BucketName=m2manager-faktury

# Ile minut ma być ważny link do podglądu zdjęcia.
R2__PresignedUrlMinutes=60

# Opcjonalnie: pełny endpoint. Domyślnie budowany jako https://<AccountId>.r2.cloudflarestorage.com
R2__ServiceUrl=

# ---------------------------------------------------------------- Gemini API (odczyt faktur)
# Klucz z https://aistudio.google.com/apikey (darmowy tier w zupełności wystarcza).
# Bez niego upload działa, ale bez automatycznego odczytu danych.
Gemini__ApiKey=

# Model z obsługą obrazu. Flash jest tani i szybki; przy słabej jakości zdjęć spróbuj gemini-3.6-pro.
Gemini__Model=gemini-3.6-flash

Gemini__MaxOutputTokens=4096
Gemini__TimeoutSeconds=90

# ---------------------------------------------------------------- upload
Upload__MaxFileSizeMb=15

# Katalog używany TYLKO wtedy, gdy R2 nie jest skonfigurowane (tryb deweloperski).
# Na Renderze dysk kontenera jest ulotny — na produkcji zawsze konfiguruj R2.
Upload__LocalStoragePath=App_Data/uploads
