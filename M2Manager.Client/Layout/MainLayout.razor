@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject ApiClient Api
@inject AppState State
@inject CookieAuthenticationStateProvider AuthProvider

<AuthorizeView>
    <Authorized>
        <div class="app-shell">
            <aside class="sidebar">
                <a class="brand" href="">
                    <span class="brand-mark">m²</span>
                    <span>M2Manager</span>
                </a>

                <NavMenu />

                <div class="sidebar-footer">
                    <div class="row-between">
                        <div class="sidebar-user">
                            <span class="avatar">@Initial(context.User.Identity?.Name)</span>
                            <span>@context.User.Identity?.Name</span>
                        </div>
                        <button class="btn btn-sm" title="Wyloguj" @onclick="LogoutAsync">
                            <i class="bi bi-box-arrow-right"></i>
                        </button>
                    </div>
                </div>
            </aside>

            <div class="main-area">
                <header class="topbar">
                    <a class="brand" href="">
                        <span class="brand-mark">m²</span>
                        <span>M2Manager</span>
                    </a>
                    <div class="btn-row">
                        <a class="btn btn-sm" href="ustawienia" title="Słowniki"><i class="bi bi-gear"></i></a>
                        <button class="btn btn-sm" title="Wyloguj" @onclick="LogoutAsync">
                            <i class="bi bi-box-arrow-right"></i>
                        </button>
                    </div>
                </header>

                <main class="content">
                    @Body
                </main>
            </div>

            <NavMenu Bottom="true" />
        </div>
    </Authorized>
    <NotAuthorized>
        @Body
    </NotAuthorized>
</AuthorizeView>

@code {
    /// <summary>Pierwsza litera loginu do awatara w stopce menu.</summary>
    private static string Initial(string? name) =>
        string.IsNullOrWhiteSpace(name) ? "?" : name.Trim()[..1];

    private async Task LogoutAsync()
    {
        try
        {
            await Api.LogoutAsync();
        }
        catch (ApiException)
        {
            // Nawet gdy serwer nie odpowie, lokalnie i tak kończymy sesję.
        }

        State.Invalidate();
        AuthProvider.NotifySignedOut();
        Navigation.NavigateTo("logowanie");
    }
}
