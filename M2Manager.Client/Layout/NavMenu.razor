@* Ta sama lista pozycji renderowana jako sidebar (desktop) albo dolny pasek (telefon). *@

@if (Bottom)
{
    <nav class="bottom-nav">
        @foreach (var item in Items)
        {
            <NavLink href="@item.Href" Match="@item.Match">
                <span class="nav-icon"><i class="bi @item.Icon"></i></span>
                <span>@item.ShortLabel</span>
            </NavLink>
        }
    </nav>
}
else
{
    <nav class="nav-links">
        @foreach (var item in Items)
        {
            <NavLink href="@item.Href" Match="@item.Match">
                <span class="nav-icon"><i class="bi @item.Icon"></i></span>
                <span>@item.Label</span>
            </NavLink>
        }
        <NavLink href="faktury/dodaj" Match="NavLinkMatch.All">
            <span class="nav-icon"><i class="bi bi-camera"></i></span>
            <span>Dodaj fakturę</span>
        </NavLink>
        <NavLink href="ustawienia" Match="NavLinkMatch.Prefix">
            <span class="nav-icon"><i class="bi bi-gear"></i></span>
            <span>Słowniki</span>
        </NavLink>
    </nav>
}

@code {
    /// <summary>true = wersja dla telefonu (dolny pasek z pięcioma ikonami).</summary>
    [Parameter]
    public bool Bottom { get; set; }

    /// <summary>Icon to nazwa klasy Bootstrap Icons — konsekwentnie warianty konturowe, bez „-fill”.</summary>
    private sealed record NavItem(string Href, string Label, string ShortLabel, string Icon, NavLinkMatch Match);

    private static readonly NavItem[] Items =
    [
        new("", "Pulpit", "Pulpit", "bi-house", NavLinkMatch.All),
        new("faktury", "Faktury", "Faktury", "bi-receipt", NavLinkMatch.Prefix),
        new("zakupy", "Lista zakupów", "Zakupy", "bi-cart3", NavLinkMatch.Prefix),
        new("mieszkania", "Mieszkania", "Metraż", "bi-rulers", NavLinkMatch.Prefix),
        new("raporty", "Raporty", "Raporty", "bi-bar-chart", NavLinkMatch.Prefix)
    ];
}
