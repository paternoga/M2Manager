@inject ApiClient Api
@inject AppState State

@* Pozycje odczytane z faktury — każdą można poprawić i przenieść na listę zakupów jako osobny wiersz. *@

@if (_items.Count == 0)
{
    <div class="card">
        <div class="card-title">
            <h2>Pozycje z faktury</h2>
            <button class="btn btn-sm" @onclick="AddEmptyRow">
                <i class="bi bi-plus-lg"></i> Dodaj pozycję ręcznie
            </button>
        </div>
        <p class="small muted" style="margin:0">
            @(Invoice.OcrStatus == OcrStatus.Extracted
                ? "AI nie wyodrębniło pojedynczych pozycji — dokument pokazuje zapewne tylko kwotę łączną."
                : "Brak odczytanych pozycji.")
            Możesz dopisać je ręcznie.
        </p>
    </div>
}
else
{
    <div class="card line-items">
        <div class="card-title">
            <h2>Pozycje z faktury</h2>
            <span class="badge badge-info">@_items.Count poz.</span>
        </div>

        <StatusMessage Error="@_error" Success="@_success" />

        @if (Invoice.LinkedShoppingItemsCount > 0)
        {
            <div class="alert alert-ok">
                Z tej faktury dodano już @Invoice.LinkedShoppingItemsCount pozycji na listę zakupów.
                Ponowne dodanie utworzy duplikaty.
            </div>
        }

        <p class="small muted">
            Wszystko możesz poprawić przed dodaniem — AI bywa nieprecyzyjne przy długich nazwach i cenach.
            Zmiana ilości albo ceny jednostkowej przelicza wartość automatycznie.
        </p>

        <div class="table-wrap">
            <table class="data">
                <thead>
                <tr>
                    <th style="width:2rem">
                        <input type="checkbox" checked="@AllSelected" @onchange="ToggleAll" title="Zaznacz wszystkie" />
                    </th>
                    <th style="min-width:16rem">Pozycja</th>
                    <th style="width:5.5rem">Ilość</th>
                    <th style="width:5rem">Jedn.</th>
                    <th style="width:6.5rem">Cena szt.</th>
                    <th style="width:7rem">Wartość</th>
                    <th style="width:9rem">Kategoria</th>
                    <th style="width:2.5rem"></th>
                </tr>
                </thead>
                <tbody>
                @foreach (var row in _items)
                {
                    var item = row;

                    <tr>
                        <td>
                            <input type="checkbox" checked="@_selected.Contains(item)"
                                   @onchange="e => Toggle(item, e.Value is true)" />
                        </td>
                        <td>
                            <input type="text" value="@item.Name" @onchange="e => SetName(item, e.Value)" />
                        </td>
                        <td>
                            <input type="number" step="0.001" value="@item.Quantity"
                                   @onchange="e => SetQuantity(item, e.Value)" />
                        </td>
                        <td>
                            <input type="text" value="@item.Unit" placeholder="szt." @onchange="e => SetUnit(item, e.Value)" />
                        </td>
                        <td>
                            <input type="number" step="0.01" value="@item.UnitPrice"
                                   @onchange="e => SetUnitPrice(item, e.Value)" />
                        </td>
                        <td>
                            <input type="number" step="0.01" value="@item.TotalPrice"
                                   @onchange="e => SetTotalPrice(item, e.Value)" />
                        </td>
                        <td>
                            <select value="@(item.SuggestedCategoryName ?? "")" @onchange="e => SetCategory(item, e.Value)">
                                <option value="">— bez kategorii —</option>
                                @foreach (var category in _categories)
                                {
                                    <option value="@category.Name">@category.Name</option>
                                }
                            </select>
                        </td>
                        <td>
                            <button class="btn btn-sm btn-danger btn-icon" title="Usuń wiersz"
                                    @onclick="() => RemoveRow(item)"><i class="bi bi-x-lg"></i></button>
                        </td>
                    </tr>
                }
                </tbody>
                <tfoot>
                <tr class="total-row">
                    <td colspan="5">Zaznaczono @_selected.Count z @_items.Count</td>
                    <td class="num">@Fmt.MoneyShort(SelectedTotal)</td>
                    <td colspan="2"></td>
                </tr>
                </tfoot>
            </table>
        </div>

        @if (SumMismatch is { } difference)
        {
            <div class="alert alert-warn" style="margin-top:.7rem">
                Suma pozycji (@Fmt.MoneyShort(LineItemsTotal)) różni się od kwoty faktury
                (@Fmt.MoneyShort(Invoice.Amount)) o @Fmt.MoneyShort(difference).
                Przy kilku towarach to zwykle koszt dostawy, którego nie rozdzielamy na pozycje.
                W innym wypadku sprawdź, czy AI nie pominęło wiersza.
            </div>
        }

        <div class="grid-2" style="margin-top:.8rem">
            <div class="field">
                <label for="li-room">Pomieszczenie dla dodawanych pozycji</label>
                <select id="li-room" value="@(_roomId?.ToString() ?? "")" @onchange="OnRoomChanged">
                    <option value="">@ShoppingConstants.WholePropertyRoomName</option>
                    @foreach (var room in _rooms)
                    {
                        <option value="@room.Id">@room.Name</option>
                    }
                </select>
            </div>

            <div class="field">
                <label for="li-status">Status</label>
                <select id="li-status" value="@_status" @onchange="OnStatusChanged">
                    @foreach (var status in Enum.GetValues<ShoppingStatus>())
                    {
                        <option value="@status">@PolishLabels.For(status)</option>
                    }
                </select>
            </div>
        </div>

        <div class="btn-row">
            <button class="btn btn-primary" disabled="@(_busy || _selected.Count == 0)" @onclick="AddSelectedAsync">
                @if (_busy)
                {
                    <text>Dodawanie…</text>
                }
                else
                {
                    <i class="bi bi-plus-lg"></i>
                    <text>Dodaj @_selected.Count poz. do listy zakupów</text>
                }
            </button>
            <button class="btn" @onclick="AddEmptyRow"><i class="bi bi-plus-lg"></i> Dodaj pozycję ręcznie</button>
            <a class="btn" href="@($"zakupy?mieszkanie={Invoice.PropertyId}")">Otwórz listę zakupów</a>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public InvoiceDto Invoice { get; set; } = default!;
    [Parameter] public EventCallback OnAdded { get; set; }

    // Pracujemy na kopii referencji, a zaznaczenie trzymamy po obiekcie, nie po indeksie —
    // dzięki temu usunięcie wiersza nie rozjeżdża zaznaczenia pozostałych.
    private readonly List<OcrLineItemDto> _items = [];
    private readonly HashSet<OcrLineItemDto> _selected = [];

    private List<RoomDto> _rooms = [];
    private List<LookupDto> _categories = [];
    private int? _roomId;
    private ShoppingStatus _status = ShoppingStatus.Bought;
    private bool _busy;
    private string? _error;
    private string? _success;
    private int _loadedInvoiceId = -1;

    private bool AllSelected => _items.Count > 0 && _selected.Count == _items.Count;

    private decimal SelectedTotal => _selected.Sum(i => i.TotalPrice ?? 0m);

    private decimal LineItemsTotal => _items.Sum(l => l.TotalPrice ?? 0m);

    /// <summary>Różnica większa niż grosz sugeruje, że model pominął jakiś wiersz.</summary>
    private decimal? SumMismatch
    {
        get
        {
            if (Invoice.Amount is not { } amount || LineItemsTotal == 0m)
            {
                return null;
            }

            var difference = Math.Abs(amount - LineItemsTotal);
            return difference > 0.01m ? difference : null;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedInvoiceId == Invoice.Id)
        {
            return;
        }

        _loadedInvoiceId = Invoice.Id;
        _error = null;
        _success = null;

        _items.Clear();
        _selected.Clear();

        foreach (var line in Invoice.LineItems)
        {
            _items.Add(line);
            _selected.Add(line); // domyślnie wszystko zaznaczone — częściej dodaje się całą fakturę
        }

        _roomId = Invoice.RoomId;

        try
        {
            _rooms = Invoice.PropertyId > 0 ? await State.GetRoomsAsync(Invoice.PropertyId) : [];
            _categories = await State.GetShoppingCategoriesAsync();
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
    }

    // ---------------------------------------------------------------- edycja wierszy

    private static void SetName(OcrLineItemDto item, object? value) =>
        item.Name = value?.ToString()?.Trim() ?? string.Empty;

    private static void SetUnit(OcrLineItemDto item, object? value)
    {
        var text = value?.ToString()?.Trim();
        item.Unit = string.IsNullOrWhiteSpace(text) ? null : text;
    }

    private static void SetCategory(OcrLineItemDto item, object? value)
    {
        var text = value?.ToString();
        item.SuggestedCategoryName = string.IsNullOrWhiteSpace(text) ? null : text;
    }

    private static void SetQuantity(OcrLineItemDto item, object? value)
    {
        item.Quantity = ParseNullable(value);
        Recalculate(item);
    }

    private static void SetUnitPrice(OcrLineItemDto item, object? value)
    {
        item.UnitPrice = ParseNullable(value);
        Recalculate(item);
    }

    /// <summary>Ręcznie wpisana wartość jest ostateczna — nie przeliczamy jej z ilości.</summary>
    private static void SetTotalPrice(OcrLineItemDto item, object? value) =>
        item.TotalPrice = ParseNullable(value);

    private static void Recalculate(OcrLineItemDto item)
    {
        if (item is { Quantity: not null, UnitPrice: not null })
        {
            item.TotalPrice = Math.Round(
                item.Quantity.Value * item.UnitPrice.Value, 2, MidpointRounding.AwayFromZero);
        }
    }

    private void AddEmptyRow()
    {
        var item = new OcrLineItemDto { Name = "Nowa pozycja", Quantity = 1, Unit = "szt." };
        _items.Add(item);
        _selected.Add(item);
    }

    private void RemoveRow(OcrLineItemDto item)
    {
        _items.Remove(item);
        _selected.Remove(item);
    }

    private void Toggle(OcrLineItemDto item, bool selected)
    {
        if (selected)
        {
            _selected.Add(item);
        }
        else
        {
            _selected.Remove(item);
        }
    }

    private void ToggleAll(ChangeEventArgs e)
    {
        _selected.Clear();

        if (e.Value is true)
        {
            foreach (var item in _items)
            {
                _selected.Add(item);
            }
        }
    }

    // ---------------------------------------------------------------- pozostałe pola

    private void OnRoomChanged(ChangeEventArgs e) =>
        _roomId = int.TryParse(e.Value?.ToString(), out var id) ? id : null;

    private void OnStatusChanged(ChangeEventArgs e) =>
        _status = Enum.TryParse<ShoppingStatus>(e.Value?.ToString(), out var status)
            ? status
            : ShoppingStatus.Bought;

    private async Task AddSelectedAsync()
    {
        var items = _items.Where(_selected.Contains).Where(i => !string.IsNullOrWhiteSpace(i.Name)).ToList();

        if (items.Count == 0)
        {
            _error = "Zaznaczone pozycje muszą mieć nazwę.";
            return;
        }

        _busy = true;
        _error = null;
        _success = null;

        try
        {
            var created = await Api.CreateShoppingItemsFromInvoiceAsync(Invoice.Id, new()
            {
                RoomId = _roomId,
                Status = _status,
                Items = items
            });

            Invoice.LinkedShoppingItemsCount += created.Count;
            _success = $"Dodano {created.Count} poz. do listy zakupów.";

            await OnAdded.InvokeAsync();
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private static decimal? ParseNullable(object? value)
    {
        var text = value?.ToString();

        if (string.IsNullOrWhiteSpace(text))
        {
            return null;
        }

        return decimal.TryParse(text.Replace(',', '.'), NumberStyles.Any, CultureInfo.InvariantCulture, out var parsed)
            ? parsed
            : null;
    }
}
