<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Czyścimy źródła odziedziczone z globalnej konfiguracji NuGet (m.in. lokalne
    katalogi DevExpress, które nie istnieją na każdej maszynie i wywalają restore).
    Projekt potrzebuje wyłącznie nuget.org.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
